# Model file path; a relative path is resolved from the project folder.
MODEL_PATH=best.pt
MODEL_SOURCE=path

# Local MLflow tracking server.
MLFLOW_TRACKING_URI=http://127.0.0.1:5000
MLFLOW_EXPERIMENT_NAME=road-crack-yolo11m
MLFLOW_REGISTERED_MODEL_NAME=road-crack-yolo11m
MODEL_REGISTRY_ALIAS=production

# Roboflow data/model identifiers. These are metadata, not API credentials.
DATASET_NAME=road-crack-detection-severity
ROBOFLOW_VERSION=1
MODEL_TYPE=yolo11m

# Local OpenLineage event output.
OPENLINEAGE_NAMESPACE=road-crack-detection
OPENLINEAGE_EVENT_DIR=lineage/events
ROBOFLOW_WORKSPACE=neeraj-samala

# Local Prometheus metrics endpoint used by the Streamlit app.
PROMETHEUS_METRICS_PORT=8000

# Alertmanager SMTP settings. Put real values only in your ignored local .env.
ALERTMANAGER_SMTP_SMARTHOST=smtp.example.com:587
ALERTMANAGER_SMTP_FROM=alerts@example.com
ALERTMANAGER_SMTP_USERNAME=replace-with-smtp-username
ALERTMANAGER_SMTP_PASSWORD=replace-with-smtp-app-password
ALERTMANAGER_EMAIL_TO=you@example.com
